# PostgreSQL connection string. Keep real credentials only in your hosting provider's secrets.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/manhole_guard

# Required for POST /api/readings. Generate a long random value; never commit the real key.
API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated exact frontend origins. No trailing slash.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# A reading older than this many seconds is reported as OFFLINE.
OFFLINE_AFTER_SECONDS=30
